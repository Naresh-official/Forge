// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum OAuthProvider {
    GITHUB
    GOOGLE
}

enum RepositoryProvider {
    GITHUB
    GITLAB // TODO:
    BITBUCKET // TODO:
}

enum DeploymentStatus {
    QUEUED
    BUILDING
    DEPLOYING
    READY
    FAILED
    CANCELLED
}

enum DomainType {
    CUSTOM
    SYSTEM
}

enum DomainStatus {
    PENDING
    ACTIVE
    FAILED
}

enum BuildStatus {
    QUEUED
    BUILDING
    SUCCEEDED
    FAILED
    CANCELLED
}

enum GitHubAccountType {
    USER
    ORGANIZATION
}

// ─────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────

model User {
    id        String   @id @default(uuid()) @db.Uuid
    name      String?
    email     String   @unique
    image     String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    accounts      Account[]
    projects      Project[]
    deployments   Deployment[]         @relation("DeploymentCreatedBy")
    installations GitHubInstallation[]

    @@map("users")
}

// ─────────────────────────────────────────────
// OAuth Accounts
// ─────────────────────────────────────────────

model Account {
    id                String        @id @default(uuid()) @db.Uuid
    userId            String        @db.Uuid
    provider          OAuthProvider
    providerAccountId String
    accessToken       String
    createdAt         DateTime      @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, provider])
    @@index([userId])
    @@map("accounts")
}

// ─────────────────────────────────────────────
// Projects
// ─────────────────────────────────────────────

model Project {
    id        String   @id @default(uuid()) @db.Uuid
    userId    String   @db.Uuid
    name      String
    slug      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    deployments          Deployment[]
    domains              Domain[]
    environmentVariables EnvironmentVariable[]
    githubRepository     GitHubRepository?

    @@unique([userId, slug])
    @@index([userId])
    @@map("projects")
}

// ─────────────────────────────────────────────
// Deployments
// ─────────────────────────────────────────────

model Deployment {
    id               String           @id @default(uuid()) @db.Uuid
    projectId        String           @db.Uuid
    deploymentNumber Int
    commitSha        String
    commitMessage    String?
    branch           String
    status           DeploymentStatus
    // Container deployment
    imageUrl         String?
    imageTag         String?

    // Static deployment
    artifactBucket String?
    artifactKey    String?
    createdBy      String    @db.Uuid
    createdAt      DateTime  @default(now())
    startedAt      DateTime?
    completedAt    DateTime?

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    createdByUser User @relation("DeploymentCreatedBy", fields: [createdBy], references: [id])

    resources DeploymentResource?
    domains   Domain[]
    build     Build?

    @@unique([projectId, deploymentNumber])
    @@index([projectId])
    @@index([createdBy])
    @@index([status])
    @@map("deployments")
}

// ─────────────────────────────────────────────
// Deployment Resources
// ─────────────────────────────────────────────

model DeploymentResource {
    id                 String  @id @default(uuid()) @db.Uuid
    deploymentId       String  @unique @db.Uuid
    cpuMillicores      Int
    memoryMb           Int
    ephemeralStorageMb Int
    autoscalingEnabled Boolean

    deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

    @@map("deploymentResources")
}

// ─────────────────────────────────────────────
// Domains
// ─────────────────────────────────────────────

model Domain {
    id           String       @id @default(uuid()) @db.Uuid
    projectId    String       @db.Uuid
    deploymentId String?      @db.Uuid
    hostname     String       @unique
    type         DomainType
    status       DomainStatus
    isPrimary    Boolean      @default(false)
    createdAt    DateTime     @default(now())

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    deployment Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

    @@index([projectId])
    @@index([deploymentId])
    @@map("domains")
}

// ─────────────────────────────────────────────
// Project Environment Variables
// ─────────────────────────────────────────────

model EnvironmentVariable {
    id             String   @id @default(uuid()) @db.Uuid
    projectId      String   @db.Uuid
    key            String
    valueEncrypted String
    isSecret       Boolean  @default(true)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@unique([projectId, key])
    @@index([projectId])
    @@map("environmentVariables")
}

// ─────────────────────────────────────────────
// Builds
// ─────────────────────────────────────────────

model Build {
    id           String      @id @default(uuid()) @db.Uuid
    deploymentId String      @unique @db.Uuid
    status       BuildStatus
    logsPath     String?
    createdAt    DateTime    @default(now())
    startedAt    DateTime?
    completedAt  DateTime?

    deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

    @@map("builds")
}

// ─────────────────────────────────────────────
// GitHub Installations
// ─────────────────────────────────────────────

model GitHubInstallation {
    id             String            @id @default(uuid()) @db.Uuid
    userId         String            @db.Uuid
    installationId String            @unique
    accountLogin   String
    accountType    GitHubAccountType
    createdAt      DateTime          @default(now())
    updatedAt      DateTime          @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    repositories GitHubRepository[]

    @@index([userId])
    @@map("githubInstallations")
}

// ─────────────────────────────────────────────
// GitHub Repositories
// ─────────────────────────────────────────────

model GitHubRepository {
    id             String   @id @default(uuid()) @db.Uuid
    installationId String   @db.Uuid
    projectId      String?  @unique @db.Uuid
    repositoryId   String
    fullName       String
    defaultBranch  String   @default("main")
    createdAt      DateTime @default(now())

    installation GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

    project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@unique([installationId, repositoryId])
    @@index([installationId])
    @@map("githubRepositories")
}
