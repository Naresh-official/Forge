{
    "name": "Forge",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "lint": "turbo lint",
        "format": "prettier --write .",
        "typecheck": "turbo typecheck"
    },
    "devDependencies": {
        "@forge/config": "workspace:*",
        "@forge/eslint-config": "workspace:*",
        "@forge/typescript-config": "workspace:*",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "ts-proto": "^2.12.0",
        "turbo": "^2.9.18",
        "typescript": "^5"
    },
    "packageManager": "bun@1.3.14",
    "engines": {
        "node": ">=20"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "dependencies": {
        "@bufbuild/protobuf": "^2.14.0",
        "@grpc/grpc-js": "^1.14.4",
        "@grpc/proto-loader": "^0.8.1",
        "zod": "^4.4.3"
    }
}
