---------------------------------------- Common ENVs ----------------------------------------
# Server environment
NODE_ENV=development

# Redis (used by builder, deployer, api for live log streaming, and log-router)
REDIS_URL="redis://localhost:6379"


---------------------------------------- Api ENVs -------------------------------------------
ALLOWED_ORIGIN_1="http://localhost:3000"

# Database configuration (used by api)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forge?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/forge?schema=public"

# API-only key used to encrypt project environment variables at rest
# (AES-256-GCM). Generate with: openssl rand -base64 32
ENV_ENCRYPTION_SECRET="generate-a-secure-random-key"

# Github integrations
GITHUB_APP_ID="your-github-app-id"
GITHUB_APP_SLUG="your-github-app-slug"
GITHUB_APP_PRIVATE_KEY_PATH="./secrets/github-app.pem"
# Webhook secret for auto deployments. Point the GitHub App's Webhook URL at
# https://<api-host>/api/v1/webhooks/github, subscribe it to "push" events and
# set the same secret here. A push to the branch a project deploys queues a new
# deployment; once it is READY the older deployments are cancelled.
GITHUB_WEBHOOK_SECRET="generate-a-secure-random-key"

BUILDER_GRPC_URL="localhost:8002"

# Log router (Fluent Bit Forward protocol receiver)
LOG_ROUTER_PORT=8010

# S3 bucket for persisted logs (forge-logs)
LOGS_BUCKET="forge-logs"

---------------------------------------- Web ENVs -------------------------------------------
# Auth secrets
AUTH_SECRET="generate-a-secure-random-key-in-production"
AUTH_GITHUB_ID="your-auth-github-id"
AUTH_GITHUB_SECRET="your-auth-github-secret"

# Next.js Public Config (used by web to connect to api)
NEXT_PUBLIC_API_URL="http://localhost:8000"

---------------------------------------- AWS ENVs -------------------------------------------

# Shared AWS credentials used by builder (S3 + ECR), deployer (ECR),
# api (log retrieval), and log-router (log persistence)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

---------------------------------------- Builder ENVs ---------------------------------------

# Builder configurations
# (REDIS_URL is shared above in Common ENVs)

API_GRPC_URL="localhost:8001"

# S3 artifact storage (replaces MinIO)
S3_BUCKET="forge-project"

# Amazon ECR (builder pushes images here)
ECR_REGISTRY_ID="123456789012"
ECR_REPOSITORY= 

---------------------------------------- Deployer ENVs --------------------------------------

# Deployer configurations
DEPLOYER_GRPC_URL="localhost:8003"

# Amazon ECR (deployer pulls images from here)
ECR_REGISTRY_ID="123456789012"
