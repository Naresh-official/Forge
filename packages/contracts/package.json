{
    "name": "@forge/contracts",
    "module": "src/index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "proto:generate": "protoc --plugin=protoc-gen-ts_proto=../../node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/generated --ts_proto_opt=outputServices=grpc-js,esModuleInterop=true --proto_path=./proto ./proto/*.proto"
    },
    "exports": {
        ".": "./src/index.ts"
    },
    "devDependencies": {
        "@types/bun": "latest"
    },
    "peerDependencies": {
        "typescript": "^5"
    }
}
