{
    "extends": "@forge/typescript-config/nextjs.json",
    "compilerOptions": {
        "paths": {
            "@/*": ["./*"],
            "@forge/ui/*": ["../../packages/ui/src/*"]
        },
        "plugins": [
            {
                "name": "next"
            }
        ],
        "declaration": false,
        "declarationMap": false
    },
    "include": [
        "next-env.d.ts",
        "next.config.ts",
        "**/*.ts",
        "**/*.tsx",
        "**/*.mts",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
